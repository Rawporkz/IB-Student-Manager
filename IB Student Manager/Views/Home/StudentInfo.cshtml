@*
	For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	IList<IList<Object>> Data = ViewData["Data"] as IList<IList<Object>>;
	int[] Pos = ViewData["Row"] as int[];

	<table class="table table-hover">

		@if (Pos[0] == 0)
		{
			Pos[0] = 1;
		}
		@for (int x = 0; x < Data[Pos[0]].Count; x++)
		{
			if(x != 2)
			{
				<th>@Data[0][x]</th>
			}
			
		}
		<tr>
			@for (int n = 0; n < Data[Pos[0]].Count; n++)
			{
				if (n != 2)
				{
					<td>@Data[Pos[0]][n]</td>
				}
				
			}

		</tr>

	</table>
}
