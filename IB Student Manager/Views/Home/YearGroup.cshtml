@{
	IList<IList<Object>> Data = ViewData["Data"] as IList<IList<Object>>;



	<body>
		<h1>@ViewData["Day"]</h1>




		<!-- trying to add a combo box>
					<div class="YearGroups">
					<h2>Hello</h2>

					<div class="selected">
						Select Year Group
					</div>

					<div class = "options">
						<input type = "radio" class = "radio" id="Y12" name ="category"></input>

					</div>
				</div>
				</!-->


		<table class="table table-hover">
			@for (int x = 0; x < Data[0].Count; x++)
			{
				if (x != 2)
				{
					<th>@Data[0][x]</th>
				}

			}

			@for (int row = 1; row < Data.Count; row++)
			{
				@if ((string)Data[row][0] != " ")
				{
					<tr>
						@for (int col = 0; col < Data[row].Count; col++)
						{
							@if (col == 0)
							{
								var Target = "StudentInfo/" + row;
								<td><a href=@Target>@Data[row][col]</a></td>


							}
							else
							{
								if (col != 2)
								{
									<td>@Data[row][col]</td>
								}

							}

						}

					</tr>
				}
			}

		</table>


	</body>
}
